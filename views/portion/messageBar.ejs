<li  class="messageElement">
  <strong><%= message.user %></strong>
  <div>
    <%= message.text %>
    <a href="/message/<%= index %>" class="openBtn">Open</a>
  </div>
  <% const date = message.added.getDate(); %>
  <% const month = message.added.getMonth() + 1; %>
  <% const year = message.added.getFullYear(); %>
  <% const hours = message.added.getHours(); %>
  <% const minutes = message.added.getMinutes(); %>

  <i>
    <%= date %>/<%= month %>/<%= year %>,
    <%= hours %>:<%= String(minutes).padStart(2, "0") %>
  </i>
</li>